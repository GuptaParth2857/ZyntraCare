# =============================================================================
# ZyntraCare Environment Variables
# =============================================================================
# Copy this file to .env.local for development or .env.production for deploy
# Required: Update all values marked with <>
# =============================================================================

# --- CORE - Required for all environments ---
NEXTAUTH_SECRET=<generate-random-32-character-string>
AUTH_SECRET=<generate-random-32-character-string>
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
ADMIN_SECRET=<generate-secure-admin-secret>

# --- DATABASE ---
# Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) - Uncomment and update:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- GOOGLE OAUTH (Optional) ---
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-client-secret>

# --- GEMINI AI (Optional - for symptom checker, AI chat) ---
# GEMINI_API_KEY=<your-gemini-api-key>

# --- SENTRY (For error monitoring) ---
# NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>
# SENTRY_ORG=<your-sentry-org>
# SENTRY_PROJECT=<your-sentry-project>

# --- TWILIO (For OTP, SOS SMS) ---
# TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
# TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
# TWILIO_PHONE_NUMBER=<your-twilio-phone-number>
# EMERGENCY_ALERT_PHONE=<recipient-phone-for-sos>

# --- EMAIL SMTP (For notifications, welcome emails) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=ZyntraCare <noreply@zyntracare.com>

# --- RAZORPAY (For subscription payments) ---
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# --- AD NETWORK (Google AdSense or Adsterra) ---
# Options: 'adsense' (default), 'adsterra', or 'none'
# NEXT_PUBLIC_AD_NETWORK=adsense
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxx
# NEXT_PUBLIC_HACKATHON_MODE=false

# --- GOOGLE PLACES (For hospital seeding) ---
# GOOGLE_PLACES_API_KEY=<your-google-places-api-key>

# --- OPEN GOVERNMENT DATA INDIA (data.gov.in - Blood Banks Directory) ---
# Free API key from https://data.gov.in (My Account -> API Key). Optional: falls back to public sandbox key.
# OGD_API_KEY=<your-free-data-gov-in-api-key>

# --- OLLAMA (For local AI chat - optional) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- REDIS (For distributed caching - optional, falls back to in-memory) ---
# REDIS_URL=redis://localhost:6379

# --- WHATSAPP (For WhatsApp notifications via Twilio) ---
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=zyntracare
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=zyntracare
