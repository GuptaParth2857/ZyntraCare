# =============================================================================
# ZyntraCare Environment Variables
# =============================================================================
# Copy this file to .env.local for development or .env.production for deploy
# Required: Update all values marked with <>
# =============================================================================

# --- CORE - Required for all environments ---
NEXTAUTH_SECRET=<generate-random-32-character-string>
AUTH_SECRET=<generate-random-32-character-string>
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000
ADMIN_SECRET=<generate-secure-admin-secret>

# --- DATABASE ---
# Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) - Uncomment and update:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- GOOGLE OAUTH (Optional) ---
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-client-secret>

# --- GEMINI AI (Optional) ---
# GEMINI_API_KEY=<your-gemini-api-key>

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=zyntracare
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=zyntracare

# LibreChat backend variables (required for monorepo Vercel deploy)
NEXT_PUBLIC_LIBRECHAT_BASE_URL=/librechat
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/LibreChat?retryWrites=true&w=majority
MEILI_HOST=https://<your-meilisearch-host>.net
MEILI_MASTER_KEY=your-meilisearch-master-key
GOOGLE_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# Add any other API keys you wish to enable in LibreChat
# e.g., GROQ_API_KEY=your-groq-api-key
#       COHERE_API_KEY=your-cohere-api-key
#       etc.

# Vane backend variables (for monorepo Vercel deploy)
NEXT_PUBLIC_VANE_BASE_URL=/vane-chat
# Vane requires a running SearxNG instance for web search
# For simplicity in this monorepo attempt, we assume you have a public SearxNG instance available
SEARXNG_URL=https://<your-searxng-instance>.net  # e.g., https://searx.be or your own
# Optional API keys for Vane's AI providers (same as LibreChat can be reused)
VANE_GOOGLE_KEY=your-google-api-key
VANE_OPENAI_API_KEY=your-openai-api-key
VANE_ANTHROPIC_API_KEY=your-anthropic-api-key
VANE_OLLAMA_HOST=http://host.docker.internal:11434  # Adjust if using Ollama locally